# Copiá este archivo como .env.local y completá con tus datos

# ── Supabase ────────────────────────────────────────────────
# Settings > API en tu proyecto de Supabase
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ── WhatsApp automático (UltraMsg) ──────────────────────────
# 1. Crear cuenta en https://ultramsg.com
# 2. Crear instancia y escanear QR con tu WhatsApp
# 3. Copiar Instance ID y Token desde el panel
VITE_ULTRAMSG_INSTANCE=instance12345
VITE_ULTRAMSG_TOKEN=tu-token-aqui
